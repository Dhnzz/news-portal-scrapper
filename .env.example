# Salin ke .env lalu sesuaikan.
POSTGRES_USER=news
POSTGRES_PASSWORD=news
POSTGRES_DB=news

TEST_POSTGRES_USER=news
TEST_POSTGRES_PASSWORD=news
TEST_POSTGRES_DB=news_test

# Dipakai app langsung (non-Docker). Contoh nilai default.
DATABASE_URL=postgresql+asyncpg://news:news@localhost:5432/news
TEST_DATABASE_URL=postgresql+asyncpg://news:news@localhost:5433/news_test
# WAJIB: ganti dengan nilai acak dan simpan rahasia.
SECRET_KEY=change-me

# Kredensial admin awal (dipakai service migrate untuk seed; opsional, ada default).
# ADMIN_USERNAME=admin
# ADMIN_PASSWORD=admin123